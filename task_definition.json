# main.tf

resource "aws_ecs_task_definition" "pipeline_task" {
  family                   = "robot-rap-worker-task"
  network_mode             = "awsvpc"
  requires_compatibilities = ["FARGATE"]
  cpu                      = "1024"
  memory                   = "4096"
  execution_role_arn       = aws_iam_role.ecs_execution_role.arn
  
  # Point Terraform to your separate JSON file
  container_definitions    = file("task_definition.json")
}
